# Local development secrets. Copy to .dev.vars (which is gitignored) for `wrangler dev`.
# In production these are set with `wrangler secret put`, never committed.

HARVEST_API_KEY=your-harvestapi-key
OPENROUTER_API_KEY=sk-or-v1-...
# Optional — omit to run without the contacts (email + phone) phase.
SIMILARWEB_API_KEY=your-similarweb-key
