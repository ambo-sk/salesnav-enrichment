{
  "name": "salesnav-enrichment-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute salesnav-enrichment --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute salesnav-enrichment --local --file=./schema.sql",
    "mint-token": "node scripts/mint-token.mjs",
    "tail": "wrangler tail",
    "test": "esbuild test/selfcheck.ts --bundle --platform=node --format=esm --outfile=.selfcheck.mjs --log-level=warning && node .selfcheck.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
